<Window x:Class="ScreenPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenPDF"
        Width="520" Height="310"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="White"
        MinWidth="400" MinHeight="250"
        Icon="sceen_icon.ico"
        Closing="Window_Closing">

    <!-- Ресурсы для цветов -->
    <Window.Resources>
        <!-- Цвет верхней панели -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#FFF7F9FB"/>
        <!-- Цвет крестика при наведении -->
        <SolidColorBrush x:Key="CloseHoverBrush" Color="#FFB94C4C"/>
        <!-- Цвет крестика при нажатии -->
        <SolidColorBrush x:Key="ClosePressedBrush" Color="#FF8A8A8A"/>
    </Window.Resources>

    <Border BorderThickness="1" CornerRadius="6" BorderBrush="#FFDCDCDC" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <!-- header -->
                <RowDefinition Height="*"/>
                <!-- content -->
                <RowDefinition Height="48"/>
                <!-- footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Название слева -->
                <TextBlock Text="ScreenPDF" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" FontSize="15" Foreground="#222" />

                <!-- Версия и кнопки справа -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="4.3" VerticalAlignment="Center" FontSize="12" Foreground="#9AA0A6" Margin="0,0,10,0"/>

                    <!-- Кнопка помощи -->
                    <Button x:Name="BtnHelp" Width="28" Height="28" Padding="0"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Background="Transparent" BorderBrush="Transparent"
                            Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="helpBg" Fill="#4DD0E1" Width="28" Height="28" Opacity="0.9"/>
                                    <TextBlock Text="?" FontSize="16" FontWeight="Bold" Foreground="White" 
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="helpBg" Property="Fill" Value="#26C6DA"/>
                                        <Setter TargetName="helpBg" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="helpBg" Property="Fill" Value="#00ACC1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ToolTip>
                            <ToolTip MaxWidth="400" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Инструкция по использованию" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="1) " FontWeight="Bold"/>
                                        <Run Text="Создать в папке "/>
                                        <Run Text="&quot;скриншоты/{год}&quot;" FontWeight="Bold"/>
                                        <Run Text=" папку с сегодняшней датой (например: "/>
                                        <Run Text="01 15" FontWeight="Bold"/>
                                        <Run Text=")"/>
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="2) " FontWeight="Bold"/>
                                        <Run Text="Перенести скриншоты с флешки в созданную папку"/>
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="3) " FontWeight="Bold"/>
                                        <Run Text="Выбрать папку "/>
                                        <Run Text="&quot;скриншоты&quot;" FontWeight="Bold"/>
                                        <Run Text=" через кнопку "/>
                                        <Run Text="&quot;Обзор&quot;" FontWeight="Bold"/>
                                        <Run Text=", если она не выбрана"/>
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="4) " FontWeight="Bold"/>
                                        <Run Text="Вписать начальный номер изделия в "/>
                                        <Run Text="левое поле" FontWeight="Bold"/>
                                        <Run Text=", нажать "/>
                                        <Run Text="Enter" FontWeight="Bold"/>
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="5) " FontWeight="Bold"/>
                                        <Run Text="Вписать конечный номер в "/>
                                        <Run Text="правое поле" FontWeight="Bold"/>
                                        <Run Text=", нажать "/>
                                        <Run Text="Enter" FontWeight="Bold"/>
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="10,10,0,0" FontStyle="Italic" Foreground="#666">
                                        <Run Text="Результат: "/>
                                        <Run Text="PDF-файлы будут созданы в папке на уровень выше от "/>
                                        <Run Text="&quot;скриншоты&quot;" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <!-- Крестик -->
                    <Button x:Name="BtnClose" Width="36" Height="28" Padding="0"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Click="BtnClose_Click"
                            Background="Transparent" BorderBrush="Transparent"
                            ToolTip="Закрыть">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="bg" Fill="#FFE76666" Width="28" Height="28" Opacity="0.9"/>
                                    <Path Data="M 10,10 L 18,18 M 18,10 L 10,18" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Fill" Value="{StaticResource CloseHoverBrush}"/>
                                        <Setter TargetName="bg" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Fill" Value="{StaticResource ClosePressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="18,20,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Поле папки -->
                    <RowDefinition Height="Auto"/>
                    <!-- Чекбокс -->
                    <RowDefinition Height="*"/>
                    <!-- Пустое пространство -->
                    <RowDefinition Height="Auto"/>
                    <!-- Поля чисел -->
                </Grid.RowDefinitions>

                <!-- Выбор папки с изображениями -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PathToImages" 
                             Grid.Column="0"
                             Height="30"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                             IsReadOnly="False"
                             Margin="0,0,10,0"/>

                    <Button x:Name="BtnBrowse" 
                            Grid.Column="1"
                            Content="Обзор" 
                            Width="80" 
                            Height="30"
                            Click="BtnBrowse_Click"/>
                </Grid>

                <!-- Чекбокс периодических испытаний -->
                <CheckBox x:Name="ChkPeriodTests" 
                          Grid.Row="1"
                          Content="Периодические испытания"
                          HorizontalAlignment="Left"
                          Margin="0,10,0,0"
                          FontSize="13"/>

                <!-- Поля ввода чисел -->
                <StackPanel Grid.Row="3" 
                          Orientation="Horizontal" 
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,20,0,0">
                    <TextBox x:Name="TxtLeft" 
                             Width="180" 
                             Height="34" 
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             KeyDown="TxtLeft_KeyDown" 
                             Margin="0,0,10,0"/>
                    <TextBlock Text="-" 
                             VerticalAlignment="Center" 
                             FontSize="18" 
                             Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtRight" 
                             Width="180" 
                             Height="34" 
                             FontSize="14"
                             VerticalContentAlignment="Center" 
                             KeyDown="TxtRight_KeyDown"/>
                </StackPanel>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#FFF6F6F6" BorderThickness="1,0,0,0" BorderBrush="#FFEAEAEA">
                <Grid Margin="12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtStatus" 
                             Text="Готов" 
                             VerticalAlignment="Center" 
                             FontSize="13" 
                             MouseLeftButtonDown="TxtStatus_MouseLeftButtonDown"
                             Foreground="#333" />

                    <StackPanel Grid.Column="1" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Center">
                        <ProgressBar x:Name="MainProgress" 
                                   Width="110" 
                                   Height="14" 
                                   Minimum="0" 
                                   Maximum="100" 
                                   Value="0"/>
                        <TextBlock x:Name="TxtPercent" 
                                 Text="0%" 
                                 VerticalAlignment="Center" 
                                 Width="36" 
                                 TextAlignment="Center" 
                                 FontSize="13"
                                 Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>