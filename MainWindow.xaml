<Window x:Class="ScreenPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenPDF"
        Width="520" Height="310"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <!-- Ресурсы для цветов -->
    <Window.Resources>
        <!-- Цвет верхней панели -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#FFF7F9FB"/>
        <!-- Цвет крестика при наведении -->
        <SolidColorBrush x:Key="CloseHoverBrush" Color="#FFB94C4C"/>
        <!-- Цвет крестика при нажатии -->
        <SolidColorBrush x:Key="ClosePressedBrush" Color="#FF8A8A8A"/>
    </Window.Resources>

    <Border BorderThickness="1" CornerRadius="6" BorderBrush="#FFDCDCDC" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <!-- header -->
                <RowDefinition Height="*"/>
                <!-- content -->
                <RowDefinition Height="48"/>
                <!-- footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <!-- Название слева -->
                <TextBlock Text="ScreenPDF" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" FontSize="15" Foreground="#222" />

                <!-- Версия и крестик справа -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="1.0" VerticalAlignment="Center" FontSize="12" Foreground="#9AA0A6" Margin="0,0,10,0"/>

                    <!-- Крестик -->
                    <Button x:Name="BtnClose" Width="36" Height="28" Padding="0"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Click="BtnClose_Click"
                            Background="Transparent" BorderBrush="Transparent"
                            ToolTip="Закрыть">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="bg" Fill="#FFE76666" Width="28" Height="28" Opacity="0.9"/>
                                    <Path Data="M 10,10 L 18,18 M 18,10 L 10,18" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Fill" Value="{StaticResource CloseHoverBrush}"/>
                                        <Setter TargetName="bg" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Fill" Value="{StaticResource ClosePressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Выбор папки с изображениями -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,30,0,40">
                    <TextBox x:Name="PathToImages" Width="370" Height="30"
         VerticalContentAlignment="Center"
         FontSize="13"
         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
         IsReadOnly="False"
         Margin="0,0,10,0"/>
                    <Button x:Name="BtnBrowse" Content="Обзор" Width="80" Height="30"
        Click="BtnBrowse_Click"/>
                </StackPanel>

                <!-- Поля ввода чисел -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="TxtLeft" Width="180" Height="34" FontSize="14"
         VerticalContentAlignment="Center"
         KeyDown="TxtLeft_KeyDown" Margin="0,0,10,0"/>
                    <TextBlock Text="-" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtRight" Width="180" Height="34" FontSize="14"
         VerticalContentAlignment="Center" KeyDown="TxtRight_KeyDown"/>
                </StackPanel>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#FFF6F6F6" BorderThickness="1,0,0,0" BorderBrush="#FFEAEAEA">
                <Grid Margin="12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtStatus" Text="Готов" VerticalAlignment="Center" FontSize="13" Foreground="#333" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ProgressBar x:Name="MainProgress" Width="110" Height="14" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="TxtPercent" Text="0%" VerticalAlignment="Center" Width="36" TextAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
